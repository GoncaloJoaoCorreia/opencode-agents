{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "driver state.json",
  "description": "Single source of truth for one driver cycle, at .plan/<slug>/state.json. Initial skeleton written by the driver, filled by preplan, read+updated by every phase. Append/merge only — never delete.",
  "type": "object",
  "required": ["version", "issue_id", "repo_root", "plan_dir", "branch", "created_at", "params", "phases"],
  "$defs": {
    "finding": {
      "type": "object",
      "description": "shared finding shape for audit/review rounds",
      "properties": {
        "id": { "type": "string", "description": "stable id, e.g. R1-F3 (round + sequence)" },
        "status": { "enum": ["pass", "fail", "skipped"] },
        "severity": { "enum": ["blocker", "major", "minor", "nit"] },
        "evidence_ref": { "type": "string", "description": "path to the full evidence file under .plan/ (never inline evidence in state)" }
      }
    }
  },
  "properties": {
    "version": { "const": 1 },
    "issue_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
      "description": "Slug. From a Linear key, or user-chosen. Validate against the pattern BEFORE using it in any path (path traversal)."
    },
    "spec": {
      "type": "object",
      "properties": {
        "source": { "enum": ["linear", "prompt", "file"] },
        "ref": { "type": "string", "description": "issue key, file path, or slug" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "spec_file": { "type": "string", "description": ".plan/<slug>/spec.md when source=prompt" }
      }
    },
    "repo_root": { "type": "string", "description": "absolute path from git rev-parse --show-toplevel" },
    "plan_dir": { "type": "string", "description": "repo-root-relative, e.g. .plan/ABC-123" },
    "branch": { "type": "string", "description": "branch the cycle runs on (feat/<slug> created on protected branches)" },
    "worktree": {
      "type": ["object", "null"],
      "properties": { "directory": { "type": "string" } },
      "description": "set when --worktree was used"
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "params": {
      "type": "object",
      "description": "Driver flags for this run.",
      "properties": {
        "phases": {
          "type": "array",
          "items": { "enum": ["preplan", "plan", "implement", "spec-audit", "code-review", "quality-gate", "write-history", "pr"] }
        },
        "skip": {
          "type": "array",
          "items": { "enum": ["preplan", "plan", "implement", "spec-audit", "code-review", "quality-gate", "write-history", "pr"] },
          "description": "--skip: phases marked skipped and never spawned (incl. per-task gate spawns). Mutually exclusive with params.phases. On a fresh run preplan/plan may not be skipped; --force never un-skips"
        },
        "worktree": { "type": "boolean" },
        "max_rounds": { "type": "integer", "minimum": 1, "default": 2 },
        "qa": { "type": "string", "description": "--qa override for state.qa.command" },
        "qa_scope": {
          "enum": ["scoped", "full"],
          "default": "scoped",
          "description": "--qa-scope: per-task (scope=task) quality-gate runs the task's manifest qa.command (\"scoped\") or the full state.qa.command (\"full\"); the cycle-scope run always runs state.qa.command"
        },
        "force": { "type": "boolean", "description": "re-run requested phases even if done" },
        "draft": { "type": "boolean", "description": "--draft: open the PR as a draft (pr phase)" },
        "variants": {
          "type": "object",
          "description": "phase -> variant name, e.g. { plan: \"thorough\" }; resolved via the driver's VARIANTS table",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "phases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": { "enum": ["pending", "running", "done", "failed", "skipped"] },
          "summary": { "type": "string", "description": "SHORT (a few lines) — big content lives in .plan/ files" },
          "started_at": { "type": "string", "format": "date-time" },
          "completed_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "plan": {
      "type": "object",
      "properties": {
        "manifest": { "type": "string", "description": "path to manifest.json" },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "explicit assumptions recorded by the plan phase (mirror of plan.md ## Assumptions); surfaced at the driver's plan-approval gate"
        },
        "open_questions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "open questions from the plan phase (mirror of plan.md); listed in the phase summary"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "file", "status"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "file": { "type": "string" },
              "status": { "enum": ["pending", "done", "skipped"] },
              "commit": { "type": "string", "description": "SHA once implemented" },
              "audit": {
                "enum": ["pass", "fail", "skipped"],
                "description": "per-task spec-audit verdict (scope=task). A task is done only with commit + audit pass + qa pass/skipped"
              },
              "qa": {
                "enum": ["pass", "fail", "skipped"],
                "description": "per-task quality-gate verdict (scope=task)"
              }
            }
          }
        }
      }
    },
    "implement": {
      "type": "object",
      "description": "one entry per driver/implement spawn (task mode or fix mode); phases.implement stays the aggregate status",
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mode", "commit", "at"],
            "properties": {
              "mode": { "enum": ["task", "fix"] },
              "task_id": { "type": "string" },
              "scope": { "enum": ["task", "cycle"], "description": "fix mode only: which gate the repair belongs to" },
              "fix_target": { "enum": ["audit", "review", "qa"], "description": "fix mode only: which state list the fix is recorded under" },
              "round": { "type": "integer" },
              "commit": { "type": "string", "description": "SHA of the commit this spawn produced" },
              "summary": { "type": "string" },
              "at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "verdict": {
          "enum": ["pass", "fail"],
          "description": "fail iff any finding with status=fail has severity blocker or major; minor/nit failures are warnings, not failures"
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scope": { "enum": ["task", "cycle"], "description": "task = verify one task's criteria right after its commit; cycle = end-of-cycle pass over everything" },
              "task_id": { "type": "string", "description": "set when scope=task" },
              "round": { "type": "integer", "description": "1-based, counted per (scope, task_id)" },
              "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
              "verdict": { "enum": ["pass", "fail"] },
              "evidence_file": { "type": "string", "description": ".plan/<slug>/audit-round-<n>.md (cycle) or .plan/<slug>/audit-<task>-round-<n>.md (task) with full evidence" }
            }
          }
        },
        "fixes": {
          "type": "array",
          "description": "repair commits spawned by the driver in fix mode",
          "items": {
            "type": "object",
            "properties": {
              "scope": { "enum": ["task", "cycle"] },
              "task_id": { "type": "string", "description": "set when scope=task" },
              "round": { "type": "integer" },
              "commit": { "type": "string" },
              "finding_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "verdict": {
          "enum": ["pass", "fail"],
          "description": "fail iff any finding has severity blocker or major; minor/nit are warnings, not failures"
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "round": { "type": "integer" },
              "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
              "verdict": { "enum": ["pass", "fail"] }
            }
          }
        },
        "fixes": {
          "type": "array",
          "description": "repair commits spawned by the driver in fix mode",
          "items": {
            "type": "object",
            "properties": {
              "round": { "type": "integer" },
              "commit": { "type": "string" },
              "finding_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "qa": {
      "type": "object",
      "properties": {
        "command": { "type": "string" },
        "candidates": { "type": "array", "items": { "type": "string" } },
        "verdict": { "enum": ["pass", "fail", "skipped"] },
        "exit_code": { "type": "integer" },
        "log": { "type": "string", "description": "path to full log under .plan/, e.g. .plan/ABC-123/qa.log" },
        "log_excerpt": { "type": "string", "description": "short tail of the log kept inline in state; the full log lives at qa.log" },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "excerpt"],
            "properties": {
              "title": { "type": "string" },
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "excerpt": { "type": "string" }
            }
          }
        },
        "runs": {
          "type": "array",
          "description": "per-task (scope=task) quality-gate runs; the cycle-scope run stays in the top-level qa fields",
          "items": {
            "type": "object",
            "required": ["scope", "round", "verdict"],
            "properties": {
              "scope": { "enum": ["task"] },
              "task_id": { "type": "string" },
              "round": { "type": "integer", "description": "1-based, counted per task" },
              "command": { "type": "string", "description": "command actually run (task qa.command or state.qa.command)" },
              "verdict": { "enum": ["pass", "fail", "skipped"], "description": "skipped when qa_scope=scoped and the task declares no qa.command" },
              "exit_code": { "type": "integer" },
              "log": { "type": "string", "description": "path to full log, e.g. .plan/<slug>/qa-<task>-round-<n>.log" },
              "failures": { "type": "array", "items": { "type": "object", "required": ["title", "excerpt"], "properties": { "title": { "type": "string" }, "file": { "type": "string" }, "line": { "type": "integer" }, "excerpt": { "type": "string" } } } }
            }
          }
        },
        "fixes": {
          "type": "array",
          "description": "repair commits spawned by the driver for quality-gate failures",
          "items": {
            "type": "object",
            "properties": {
              "scope": { "enum": ["task", "cycle"] },
              "task_id": { "type": "string", "description": "set when scope=task" },
              "round": { "type": "integer" },
              "commit": { "type": "string" },
              "failure_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "history": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "module": { "type": "string" },
              "history_file": { "type": "string" },
              "decision_file": { "type": ["string", "null"] },
              "commit": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "pr": {
      "type": "object",
      "description": "Filled by the pr phase.",
      "properties": {
        "number": { "type": "integer" },
        "url": { "type": "string" },
        "base": { "type": "string", "description": "base branch (repo default, fallback main)" },
        "head": { "type": "string", "description": "head branch (the cycle branch)" },
        "title": { "type": "string" },
        "draft": { "type": "boolean", "description": "true when opened via --draft" }
      }
    }
  },
  "additionalProperties": true
}
